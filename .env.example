# Web / Nginx entry point
#
# The domain Nginx answers for and the certificate is issued against. On the
# deployment VM this is labo-iot1.iict-heig-vd.ch, injected by the deploy
# workflow; leave it as localhost for local development.
SERVER_NAME=localhost

# Host ports for Nginx. These default to 80/443 in docker-compose.yml for the
# VM; binding those needs root on Linux, so local development uses high ports.
WEB_PORT=8080
WEB_TLS_PORT=8443

# Address Let's Encrypt sends expiry warnings to. Only used for the one-time
# certificate issuance on the VM, never locally.
CERTBOT_EMAIL=

# API — host port the NestJS API is published on (container always listens on 3000)
API_PORT=3000

# PostgreSQL
POSTGRES_USER=app_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=app_db

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET_NAME=observations

# Auth — HMAC key the API signs JWT access tokens with. At least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=changeme-generate-a-48-byte-random-secret-before-use
# Access token lifetime in seconds. 604800 = 7 days. There is no refresh token,
# so this is effectively the session length (ADR-009).
JWT_EXPIRES_IN_SECONDS=604800

# Frontend — enable the development authentication bypass only in local/debug builds.
VITE_ENABLE_AUTH_SKIP=false

# Web/PWA builds deliberately leave VITE_API_BASE_URL unset, so they call
# relative /api/... URLs through the same-origin Nginx entry point. Android
# builds load the public URL from .env.android; it can be overridden for a
# one-off build with VITE_API_BASE_URL=https://example.test npm run build:android
