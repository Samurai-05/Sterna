# Web
WEB_PORT=8080

# API — host port the NestJS API is published on (container always listens on 3000)
API_PORT=3000

# PostgreSQL
POSTGRES_USER=app_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=app_db

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET_NAME=observations

# Auth — HMAC key the API signs JWT access tokens with. At least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=changeme-generate-a-48-byte-random-secret-before-use
# Access token lifetime in seconds. 604800 = 7 days. There is no refresh token,
# so this is effectively the session length (ADR-009).
JWT_EXPIRES_IN_SECONDS=604800

# Frontend — enable the development authentication bypass only in local/debug builds.
VITE_ENABLE_AUTH_SKIP=false
